---
// 无 JavaScript 时使用构建年份兜底；浏览器会按访问当天的年份跳转。
const basePath = Astro.config?.base || '/';
const fallbackYear = new Date().getFullYear();
const fallbackTarget = `${basePath}calendar/${fallbackYear}/`;
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>正在跳转到当前年份日历…</title>
    <script is:inline>
      const year = new Date().getFullYear();
      const target = new URL(`${year}/`, window.location.href);
      window.location.replace(target.href);
    </script>
  </head>
  <body>
    <p>
      正在跳转到当前年份日历…
      如果未自动跳转，<a href={fallbackTarget}>点击这里</a>。
    </p>
  </body>
  </html>
